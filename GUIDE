### **④ Buat / Update Repository**

Repository adalah satu-satunya sumber data yang boleh diakses oleh ViewModel. **Tidak ada akses Retrofit langsung dari ViewModel.**

```kotlin
// data/repository/FarmingRepository.kt
class FarmingRepository @Inject constructor(
    private val apiService: ApiService
) {

    /**
     * Ambil data sensor terbaru dari IoT Node.
     * Selalu kembalikan NetworkResult agar ViewModel bisa handle semua state.
     */
    suspend fun getLatestSensorData(): NetworkResult<SensorResponse> {
        return try {
            val response = apiService.getLatestSensorData()
            if (response.isSuccessful && response.body() != null) {
                NetworkResult.Success(response.body()!!)
            } else {
                NetworkResult.Error("Gagal mengambil data: ${response.code()}")
            }
        } catch (e: Exception) {
            NetworkResult.Error("Koneksi gagal: ${e.localizedMessage}")
        }
    }

    suspend fun diagnosePlant(imageFile: File): NetworkResult<DiagnoseResponse> {
        return try {
            val requestFile = imageFile.asRequestBody("image/*".toMediaTypeOrNull())
            val body = MultipartBody.Part.createFormData("image", imageFile.name, requestFile)
            val response = apiService.diagnosePlant(body)
            if (response.isSuccessful && response.body() != null) {
                NetworkResult.Success(response.body()!!)
            } else {
                NetworkResult.Error("Diagnosis gagal: ${response.message()}")
            }
        } catch (e: Exception) {
            NetworkResult.Error(e.localizedMessage ?: "Terjadi kesalahan")
        }
    }
}
```

**`NetworkResult` Sealed Class** (sudah ada di `core/network/`):

```kotlin
// core/network/NetworkResult.kt
sealed class NetworkResult<out T> {
    data class Success<T>(val data: T) : NetworkResult<T>()
    data class Error(val message: String) : NetworkResult<Nothing>()
    object Loading : NetworkResult<Nothing>()
}
```

