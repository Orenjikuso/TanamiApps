### **⑥ Observasi di Fragment**

Fragment hanya boleh menangani: mengirim event ke ViewModel, dan merender state yang dikembalikan ViewModel. Tidak ada logika bisnis di Fragment.

```kotlin
// ui/farming/FarmingFragment.kt
@AndroidEntryPoint
class FarmingFragment : Fragment(R.layout.fragment_farming) {

    private val viewModel: FarmingViewModel by viewModels()
    private lateinit var binding: FragmentFarmingBinding

    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        binding = FragmentFarmingBinding.bind(view)

        setupObservers()
        setupListeners()
    }

    private fun setupObservers() {
        // Gunakan repeatOnLifecycle agar collection aman saat Fragment di-pause
        viewLifecycleOwner.lifecycleScope.launch {
            repeatOnLifecycle(Lifecycle.State.STARTED) {
                viewModel.sensorState.collect { state ->
                    when (state) {
                        is NetworkResult.Loading -> showLoadingState()
                        is NetworkResult.Success -> renderSensorData(state.data)
                        is NetworkResult.Error   -> showError(state.message)
                    }
                }
            }
        }
    }

    private fun setupListeners() {
        binding.btnRefresh.setOnClickListener {
            viewModel.fetchSensorData()
        }

        binding.btnDiagnose.setOnClickListener {
            // Buka camera / gallery picker
        }
    }

    private fun renderSensorData(data: SensorResponse) {
        binding.apply {
            tvMoisture.text    = "${data.moisture}%"
            tvTds.text         = "${data.tds} ppm"
            tvTemperature.text = "${data.temperature}°C"
            tvPhLevel.text     = "${data.phLevel} pH"
        }
    }

    private fun showLoadingState() {
        binding.shimmerLayout.startShimmer()
        binding.shimmerLayout.visibility = View.VISIBLE
        binding.contentGroup.visibility  = View.GONE
    }

    private fun showError(message: String) {
        binding.shimmerLayout.stopShimmer()
        binding.shimmerLayout.visibility = View.GONE
        Snackbar.make(binding.root, message, Snackbar.LENGTH_LONG)
            .setBackgroundTint(requireContext().getColor(R.color.error))
            .show()
    }
}
```

