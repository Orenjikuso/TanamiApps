<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warna isi kotak (putih/abu-abu sangat terang) -->
    <solid android:color="@color/neutral_50" />

    <!-- Garis luar (border) kotak -->
    <stroke android:width="1dp" android:color="@color/neutral_300" />

    <!-- Sudut melengkung -->
    <corners android:radius="@dimen/spacing_8" />

    <!-- Jarak teks ketikan ke pinggir kotak -->
    <padding
        android:top="@dimen/spacing_12"
        android:bottom="@dimen/spacing_12"
        android:left="@dimen/spacing_16"
        android:right="@dimen/spacing_16" />
</shape>